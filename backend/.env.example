# Copy this file to backend/.env and fill in your values.
# NEVER commit .env to GitHub.

# ---------- App ----------
APP_NAME=TalentPilot
COMPANY_NAME=Nimbus Technologies
# Where candidates open links from emails. Local: http://localhost:5173  Prod: https://<your-app>.onrender.com
PUBLIC_URL=http://localhost:5173
ENV=development

# ---------- HR login ----------
ADMIN_EMAIL=hr@example.com
ADMIN_PASSWORD=admin123
# Any long random string (32+ chars)
JWT_SECRET=change-me-to-a-long-random-string-0123456789

# ---------- Database ----------
# Empty = local SQLite file (fine for development).
# Production: Neon -> Dashboard -> Connect -> copy the connection string
DATABASE_URL=

# ---------- LLM (free) ----------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_SMART=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
# https://aistudio.google.com/apikey  (fallback LLM + embeddings for semantic RAG)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
# groq | gemini (which provider to try first) | fake (offline test mode)
LLM_PROVIDER=groq

# ---------- Email ----------
# console = only print to server log; brevo = real emails (free 300/day)
EMAIL_PROVIDER=console
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=TalentPilot Recruiting
HR_NOTIFY_EMAIL=
# Gmail SMTP alternative (EMAIL_PROVIDER=smtp, needs a Gmail App Password; many free hosts block SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------- Telegram (free) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_HR_CHAT_ID=
# e.g. @nimbus_jobs (bot must be an admin of the channel)
TELEGRAM_CHANNEL_ID=

# ---------- SMS (optional, Twilio trial) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Scheduler ----------
CRON_SECRET=change-me-cron-secret

# ---------- Hiring policy ----------
MAX_REPLANS=2
SCREEN_PASS_SCORE=55
ASSESSMENT_PASS_SCORE=50
INTERVIEW_QUESTIONS=6

# ---------- LangSmith tracing (optional, free) ----------
# https://smith.langchain.com -> Settings -> API Keys. Shows every agent step live.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=talentpilot
